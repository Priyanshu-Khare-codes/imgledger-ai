# HH Goa Task 3 — Environment Variables
# Copy to .env and fill in values as needed.

# InsightFace model name (default: buffalo_l)
# Options: buffalo_l, buffalo_m, buffalo_s, buffalo_sc
INSIGHTFACE_MODEL=buffalo_l

# Face match threshold (0.0 - 1.0)
# Must be calibrated against your model + test data.
# Default 0.50 is a starting point for buffalo_l, NOT a universal truth.
FACE_MATCH_THRESHOLD=0.50

# Stop processing additional candidates once similarity exceeds this
HIGH_CONFIDENCE_THRESHOLD=0.80

# Max candidates to process from search results
MAX_CANDIDATES=20

# Optional: HTTP proxy for PicImageSearch (e.g. http://proxy:8080)
# PROXY=

# FastAPI server settings
API_HOST=0.0.0.0
API_PORT=8000
